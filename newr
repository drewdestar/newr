#!/usr/bin/env python3
"""The `newr` command-line tool (M1: front end only).

Thin launcher: adds this checkout's directory to sys.path so the
`compiler` package is importable, then dispatches to compiler.cli.
The installed (pip console-script) form is the same entry point:
``compiler.cli:main`` — so this launcher also works from PowerShell
and cmd on Windows via `python newr ...` (the console script is the
packaged form, M4).
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from compiler.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
