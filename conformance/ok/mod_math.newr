# The math module (SPEC.md §12.2).
let passed = true
if math.sqrt(16.0) != 4.0:
  passed = false
if math.floor(2.7) != 2:
  passed = false
if math.ceil(2.1) != 3:
  passed = false
if math.pi < 3.14:
  passed = false
if math.pi > 3.15:
  passed = false
if math.e < 2.71:
  passed = false
if math.e > 2.72:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
