# if / elif / else chains.
let passed = true
fn grade(n: int) -> str:
  if n >= 90:
    return "A"
  elif n >= 70:
    return "B"
  elif n >= 50:
    return "C"
  else:
    return "F"

if grade(95) != "A":
  passed = false
if grade(80) != "B":
  passed = false
if grade(60) != "C":
  passed = false
if grade(10) != "F":
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
