# round() is half-away-from-zero (P2), not banker's rounding.
let passed = true
if round(2.5) != 3:
  passed = false
if round(-2.5) != -3:
  passed = false
if round(2.4) != 2:
  passed = false
if round(2.675, 2) != 2.67:
  passed = false
if round(3.5) != 4:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
