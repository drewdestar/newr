# Recursion: factorial and fibonacci.
fn fact(n: int) -> int:
  if n <= 1:
    return 1
  return n * fact(n - 1)

fn fib(n: int) -> int:
  if n <= 1:
    return n
  return fib(n - 1) + fib(n - 2)

let passed = true
if fact(5) != 120:
  passed = false
if fib(10) != 55:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
