# Enums + match (SPEC.md §8, §9): exhaustive match over variants.
enum Shape:
  Circle(radius: float)
  Square(side: float)

fn area(s: Shape) -> float:
  match s:
    Shape.Circle(radius: r):
      return 3.14 * r * r
    Shape.Square(side: sq):
      return sq * sq

print area(Shape.Circle(radius: 2.0))
