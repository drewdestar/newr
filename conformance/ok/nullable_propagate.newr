# `?` propagates a nullable (D7): none early-returns none.
fn first(xs: list[int]) -> int?:
  if xs.len() == 0:
    return none
  return xs[0]

fn second(xs: list[int]) -> int?:
  let f = first(xs)?
  return f + 1

let passed = true
if (second([10, 20]) ?? -1) != 11:
  passed = false
let e: list[int] = []
if second(e).is_none() != true:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
