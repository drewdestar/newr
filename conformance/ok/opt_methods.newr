# Nullable methods: is_some / is_none / unwrap.
let passed = true
let a: int? = 5
let b: int? = none
if a.is_some() != true:
  passed = false
if a.is_none() != false:
  passed = false
if b.is_some() != false:
  passed = false
if b.is_none() != true:
  passed = false
if a.unwrap() != 5:
  passed = false
# `?.` on nullable methods short-circuits on `none` (M2 fix #5).
let ais: bool? = a?.is_some()
if ais.unwrap() != true:
  passed = false
let bs: bool? = b?.is_some()
if bs.is_none() != true:
  passed = false
let ain: bool? = a?.is_none()
if ain.unwrap() != false:
  passed = false
let bn: bool? = b?.is_none()
if bn.is_none() != true:
  passed = false
let au: int? = a?.unwrap()
if au.unwrap() != 5:
  passed = false
let bu: int? = b?.unwrap()
if bu.is_none() != true:
  passed = false
let r: Result[int, error]? = ok(7)
let ru: int? = r?.unwrap()
if ru.unwrap() != 7:
  passed = false
let q: Result[int, error]? = none
let qu: int? = q?.unwrap()
if qu.is_none() != true:
  passed = false
let s: str? = "hi"
let su: str? = s?.unwrap().upper()
if su.unwrap() != "HI":
  passed = false
let caught = false
try:
  let v = b.unwrap()
  print v
catch e:
  caught = true
if caught != true:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
