# Top-level statements execute in file order (SPEC §8).
# An assignment between two lets must be visible to the later let.
let x = 1
x = 5
let y = x
let passed = true
if y != 5:
  passed = false
x = x + 1
let z = x * 2
if z != 12:
  passed = false
fn getx() -> int:
  return x
if getx() != 6:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
