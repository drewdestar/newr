# Result values: ok/err, is_ok/is_err, unwrap/unwrap_or.
fn div(a: int, b: int) -> Result[int, error]:
  return try a / b

let passed = true
let r1 = div(6, 2)
if r1.is_ok() != true:
  passed = false
if r1.unwrap() != 3:
  passed = false
let r2 = div(6, 0)
if r2.is_err() != true:
  passed = false
if r2.unwrap_or(99) != 99:
  passed = false
let caught = false
try:
  let v = r2.unwrap()
  print v
catch e:
  caught = true
  if e.message == "":
    passed = false
if caught != true:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
