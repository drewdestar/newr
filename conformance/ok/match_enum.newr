# Match on an enum (bare and payload variants).
enum Shape:
  Circle(radius: float)
  Square(side: float)
  Dot

fn area(s: Shape) -> float:
  match s:
    Shape.Circle(radius: r):
      return 3.14159 * r * r
    Shape.Square(side: x):
      return x * x
    Shape.Dot:
      return 0.0

let passed = true
if area(Shape.Square(side: 3.0)) != 9.0:
  passed = false
if area(Shape.Dot) != 0.0:
  passed = false
let c = area(Shape.Circle(radius: 1.0))
if c < 3.14:
  passed = false
if c > 3.15:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
