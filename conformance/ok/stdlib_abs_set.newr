# abs() on int and float, plus set construction with dedup (SPEC.md §12.1, §12.4).
let passed = true
if abs(-5) != 5:
  passed = false
if abs(5) != 5:
  passed = false
if abs(0) != 0:
  passed = false
if abs(-2.5) != 2.5:
  passed = false
if abs(2.5) != 2.5:
  passed = false
if abs(0.0) != 0.0:
  passed = false
let s = set([1, 2, 2, 3])
if len(s) != 3:
  passed = false
if s.contains(1) != true:
  passed = false
if s.contains(2) != true:
  passed = false
if s.contains(3) != true:
  passed = false
if s.contains(4) != false:
  passed = false
let names = set(["a", "b", "a"])
if len(names) != 2:
  passed = false
if names.contains("a") != true:
  passed = false
if names.contains("c") != false:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
