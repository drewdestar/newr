# Pipelines chain (a |> f |> g is g(f(a))).
fn double(n: int) -> int:
  return n * 2

fn inc(n: int) -> int:
  return n + 1

let passed = true
let y = 5 |> double |> inc
if y != 11:
  passed = false
let z = 5 |> inc |> double
if z != 12:
  passed = false
if passed:
  print "PASS"
else:
  print "FAIL"
